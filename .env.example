# Base de données Turso, pour l'app comme pour `pnpm db:schema` et `pnpm db:seed`.
# En local : copier ce fichier en .env.local (non versionné) et le remplir.
# En production (Vercel) : les mêmes variables, dans les réglages du projet.
# Sans DATABASE_URL, hors production, l'app se rabat sur un fichier SQLite (file:local.db).
DATABASE_URL=
DATABASE_AUTH_TOKEN=
